# In-distribution tool-call probe: serve a base-SFT gemma4 consolidated ckpt (TP=2, 2 GPU) and run
# probe_indist.py to decide the pre-retrain fork (distribution-shift vs pure-capability). Minutes.
#
# Env: MODEL (consolidated dir) NAME TOK DATA (optional overrides)
# Submit: sbatch --gpus-per-node=2 10_probe_indist.sub
#SBATCH -A <account>
#SBATCH -p batch
#SBATCH -t 00:40:00
#SBATCH -N 1
#SBATCH --gpus-per-node=2
#SBATCH --ntasks-per-node=1
#SBATCH -J oh3_probe
#SBATCH --output=/path/to/coderforge_cache/slurm_jobs/%x_%j.out
#SBATCH --error=/path/to/coderforge_cache/slurm_jobs/%x_%j.err

set -euxo pipefail
CACHE=/path/to/coderforge_cache
EVAL_DIR=/path/to/Automodel/examples/long_context_validation/gemma4_31B/eval
VENV="${CACHE}/eval_venv"; SQSH=/path/to/vllm.sqsh
SFT=/path/to/coderforge_ckpts/gemma4_31b_base_coderforge_cp8_64k_300steps/epoch_0_step_224/model/consolidated
MODEL="${MODEL:-$SFT}"; NAME="${NAME:-gemma4cf}"; TOK="${TOK:-$MODEL}"
DATA="${DATA:-/path/to/coderforge_cache/togethercomputer_CoderForge-Preview_filtered_reward1_seq65536/data.jsonl}"
MAXLEN="${MAXLEN:-131072}"; PORT="${PORT:-8000}"; TP="${TP:-2}"; N="${N:-3}"; MAXTOK="${MAXTOK:-4096}"
ENDPOINT="http://127.0.0.1:${PORT}/v1"; SERVELOG="${CACHE}/eval/serve_probe_${SLURM_JOB_ID}.log"
mkdir -p "${CACHE}/slurm_jobs" "${CACHE}/eval"

srun --overlap --container-image="${SQSH}" --container-mounts=/lustre:/lustre --no-container-mount-home bash -lc "
  vllm serve '${MODEL}' --served-model-name '${NAME}' --tensor-parallel-size ${TP} \
    --max-model-len ${MAXLEN} --gpu-memory-utilization 0.92 --limit-mm-per-prompt '{\"image\":0,\"audio\":0}' \
    --enable-auto-tool-choice --tool-call-parser gemma4 --host 0.0.0.0 --port ${PORT}" > "${SERVELOG}" 2>&1 &
SVPID=$!
ready=0; for i in $(seq 1 180); do curl -sf "${ENDPOINT}/models" >/dev/null 2>&1 && { ready=1; break; }; kill -0 $SVPID 2>/dev/null || { echo "serve died"; break; }; sleep 10; done
echo "vLLM READY=${ready} after ~$((i*10))s"; [ "${ready}" = "1" ] || { tail -40 "${SERVELOG}"; kill $SVPID 2>/dev/null||true; exit 1; }

# shellcheck disable=SC1091
source "${VENV}/bin/activate"; export HF_HOME="/path/to/hf_cache"
python "${EVAL_DIR}/probe_indist.py" --endpoint "${ENDPOINT}" --model "${NAME}" --tokenizer "${TOK}" --data "${DATA}" --n "${N}" --max-tokens "${MAXTOK}"
kill $SVPID 2>/dev/null || true
echo "=== PROBE DONE ==="
